set nocompatible
set number
set relativenumber
set expandtab
set tabstop=4
set shiftwidth=4
set smartindent
set incsearch
set ignorecase
set smartcase
set hlsearch
set wrap
set scrolloff=8
set termguicolors
syntax on
filetype plugin indent on

let mapleader = " "
nnoremap <leader>w :w<CR>
nnoremap <leader>q :q<CR>
nnoremap <leader>h :nohlsearch<CR>
